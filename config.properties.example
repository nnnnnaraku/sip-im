# ============================================================
# SIP 客户端配置模板
#
# 用法：把本文件复制为 config.properties，再按下面说明改成自己的值
#   Windows:  copy config.properties.example config.properties
#   Linux/Mac: cp config.properties.example config.properties
#
# 修改后无需重新编译，直接重跑程序即可生效
# ============================================================

# ---------- 本机账号 ----------
sip.username=100
sip.password=100

# ---------- SIP 服务器 ----------
# 填"跑 miniSIPServer 那台电脑"的局域网 IP（用 ipconfig 查看）
sip.server.ip=192.168.1.100
sip.server.port=5060

# ---------- 本机 ----------
# 填"本机"的局域网 IP。绝对不要用 127.0.0.1，否则别的机器连不上你
sip.local.ip=192.168.1.100
# 同一台机器上跑多个客户端时要改成不同值（5061 / 5062 / 5063 ...）
sip.local.port=5061

# 定时重新注册间隔（秒）。
# SIP 注册是"软状态"，服务器重启后注册绑定会丢失，客户端需要重新注册才会恢复。
# 因此默认设为 300（5 分钟）——服务器重启后最多 5 分钟就能自动恢复；
# 若注册请求超时，程序还会在 30 秒后立即重试一次。
# 设为 0 或负数可关闭该功能（仅用于快速测试）。
sip.register.interval.sec=300

# ---------- 被叫账号 ----------
sip.target.user=101

# ---------- 媒体 ----------
media.local.port=8000

# ---------- 文件消息（图片 / 语音） ----------
# 每个 SIP MESSAGE 承载的 Base64 字符数（图片与语音消息共用）。
# 实测：Content-Length 超过 1000 左右会被链路丢弃（UDP 包超过 MTU 后 IP 分片被丢），
# 所以保守取 800（加约 300 字节 SIP 头后仍不分片）。调大可能导致文件传不过去。
im.file.chunk.size=800

# 语音消息默认录制时长（秒）。可用 /rec <秒数> 临时指定。
im.voice.duration.sec=5

# ---------- 视频通话 ----------
# 是否启用视频（启用后 SDP 会带 m=video，通话时自动开摄像头）
video.enabled=true
# 采集分辨率与帧率（摄像头不支持时会自动退到最接近的可用分辨率）
video.width=320
video.height=240
video.fps=10
# JPEG 压缩质量（百分数，越小越省带宽但越糊）
video.quality.percent=50
# 本机视频 RTP 端口。同一台机器上跑多个客户端时要改成不同值（如 8022）
video.local.port=8020

# ---------- 会议视频（多人视频） ----------
# 拨 *6*N 进入会议室时，视频走这条应用层中继（miniSIPServer 会议室只做音频混音）。
# 中继在"服务器那台机"上启动：run-video-relay.bat，默认 UDP 9100。
# host 留空则自动使用 sip.server.ip（一般不用改）
video.relay.host=
video.relay.port=9100

# ---------- 通话行为 ----------
# 通话时长（秒），到时自动挂断
call.duration.sec=180
# 启动后是否自动呼叫被叫；只测文字消息时改成 false，避免启动就拨号
call.auto.invite=true

# ---------- 运行模式 ----------
# 常驻模式：true  = 程序持续运行，输入 /quit 或按 Ctrl+C 才退出（推荐，便于演示/调试）；
#          false = 启动后跑固定时长（通话时长 + 60 秒）自动退出。
app.keep.alive=true

# ============================================================
# 后台管理端（Web 版，独立进程，用 run-admin.bat 启动）
# ============================================================

# 后台监听端口。浏览器访问 http://<本机IP>:<admin.port>/
admin.port=8090
# 管理员登录口令
admin.password=1234

# miniSIPServer 的 Web 管理接口：后台从这里读"分机在线状态"和"会议室"
# mss.web.host 填"跑 miniSIPServer 那台电脑"的 IP；在本机跑就填 127.0.0.1 或本机 IP
mss.web.host=192.168.1.100
mss.web.port=8080
# miniSIPServer 的管理员密码
mss.web.password=1234

# ============================================================
# 网页版聊天客户端（独立进程，用 run-web.bat 启动）
# ============================================================

# 网页客户端监听端口。浏览器访问 http://<本机IP>:<web.port>/
# 注意：不要和 admin.port(8090) 冲突
web.port=8081



# 多人文字群聊复用现有SIP MESSAGE与Web端口，无新增服务器/端口配置。
# 网页创建3~8人群并确认邀请；与拨*6*1的音视频会议独立。
# 群状态仅保存在客户端进程内，重启需重建；详见GROUP_TEXT_CHAT.md。
